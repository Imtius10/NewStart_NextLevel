          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/landlord/properties/{{propertyId}}/requests", "host": ["{{baseUrl}}"], "path": ["landlord", "properties", "{{propertyId}}", "requests"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{landlordToken}}" }]
          }
        }
      ]
