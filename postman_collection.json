  "item": [
    {
      "name": "01 - Auth (Run First)",
      "item": [
        {
          "name": "Register User",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('201',()=>pm.response.code===201);","pm.test('Created',()=>d.data.id!==undefined);"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }, "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"name\":\"Test User\",\n  \"email\":\"testuser@test.com\",\n  \"password\":\"123456\",\n  \"role\":\"TENANT\"\n}" } }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Token',()=>d.data.accessToken.length>10);","if(d.data&&d.data.accessToken){pm.collectionVariables.set('adminToken',d.data.accessToken);}"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }, "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"email\":\"admin@rentnest.com\",\n  \"password\":\"admin123\"\n}" } }
        },
        {
          "name": "Login Landlord",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Token',()=>d.data.accessToken.length>10);","if(d.data&&d.data.accessToken){pm.collectionVariables.set('landlordToken',d.data.accessToken);}"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }, "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"email\":\"imtius1@example.com\",\n  \"password\":\"12345678\"\n}" } }
        },
        {
          "name": "Login Tenant",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Token',()=>d.data.accessToken.length>10);","if(d.data&&d.data.accessToken){pm.collectionVariables.set('tenantToken',d.data.accessToken);}"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }, "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode":"raw","raw":"{\n  \"email\":\"tanvir@tenant.com\",\n  \"password\":\"123456\"\n}" } }
        },
        {
          "name": "Get Profile - /auth/me",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Has email',()=>d.data.email!==undefined);","pm.test('Has role',()=>d.data.role!==undefined);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] }, "header": [{"key":"Authorization","value":"Bearer {{tenantToken}}"}] }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.code===200);","pm.test('New token',()=>pm.response.json().data.accessToken!==undefined);"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth","refresh-token"] } }
        },
        {
          "name": "Logout",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.code===200);"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] } }
        }
      ]
    },
    {
      "name": "02 - Properties Public",
      "item": [
        {
          "name": "Get All Properties",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>Array.isArray(d.data));","pm.test('Pagination',()=>d.meta.total>0);","if(d.data&&d.data.length>0){pm.collectionVariables.set('propertyId',d.data[0].id);}"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties?page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"5"}] } }
        },
        {
          "name": "Get Property by ID",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Has id',()=>d.data.id!==undefined);","pm.test('Has landlord',()=>d.data.landlord!==undefined);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties","{{propertyId}}"] } }
        },
        {
          "name": "Get Categories",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>Array.isArray(d.data));","pm.test('Has items',()=>d.data.length>0);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] } }
        },
        {
          "name": "Filter by Location",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>Array.isArray(pm.response.json().data));"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties?location=Dhaka&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query":[{"key":"location","value":"Dhaka"},{"key":"page","value":"1"},{"key":"limit","value":"5"}] } }
        },
        {
          "name": "Filter by Category",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>Array.isArray(pm.response.json().data));"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties?category=apartment&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query":[{"key":"category","value":"apartment"},{"key":"page","value":"1"},{"key":"limit","value":"5"}] } }
        },
        {
          "name": "Filter by Price",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>Array.isArray(pm.response.json().data));"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties?minPrice=20000&maxPrice=50000&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query":[{"key":"minPrice","value":"20000"},{"key":"maxPrice","value":"50000"},{"key":"page","value":"1"},{"key":"limit","value":"5"}] } }
        },
        {
          "name": "Search Properties",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>Array.isArray(pm.response.json().data));"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties?search=studio&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query":[{"key":"search","value":"studio"},{"key":"page","value":"1"},{"key":"limit","value":"5"}] } }
        }
      ]
    },
    {
      "name": "03 - Landlord Property CRUD",
      "item": [
        {
          "name": "Create Property - /landlord/properties",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('201',()=>pm.response.code===201);","pm.test('Created',()=>d.data.id!==undefined);","pm.test('Has price',()=>d.data.price>0);","if(d.data&&d.data.id){pm.collectionVariables.set('propertyId',d.data.id);}"] } }],
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/landlord/properties", "host": ["{{baseUrl}}"], "path": ["landlord","properties"] }, "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{landlordToken}}"}], "body": { "mode":"raw","raw":"{\n  \"title\":\"Luxury Flat in Banani\",\n  \"description\":\"3 bedroom apartment with pool\",\n  \"price\":65000,\n  \"location\":\"Banani, Dhaka\",\n  \"category\":\"apartment\"\n}" } }
        },
        {
          "name": "Get My Properties - /landlord/properties",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>d.data.length>0);","pm.test('Pagination',()=>d.meta!==undefined);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/landlord/properties?page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["landlord","properties"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"5"}] }, "header": [{"key":"Authorization","value":"Bearer {{landlordToken}}"}] }
        },
        {
          "name": "Update Property - /landlord/properties/:id",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Updated',()=>d.data.title==='Updated Flat');","pm.test('Price',()=>d.data.price===70000);"] } }],
          "request": { "method": "PUT", "url": { "raw": "{{baseUrl}}/landlord/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["landlord","properties","{{propertyId}}"] }, "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{landlordToken}}"}], "body": { "mode":"raw","raw":"{\n  \"title\":\"Updated Flat\",\n  \"price\":70000\n}" } }
        },
        {
          "name": "Delete Property - /landlord/properties/:id",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Deleted',()=>d.data===null);"] } }],
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/landlord/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["landlord","properties","{{propertyId}}"] }, "header": [{"key":"Authorization","value":"Bearer {{landlordToken}}"}] }
        }
      ]
    },
