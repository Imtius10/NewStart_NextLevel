          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/payments/create", "host": ["{{baseUrl}}"], "path": ["payments","create"] }, "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{tenantToken}}"}], "body": { "mode":"raw","raw":"{\n  \"rentalRequestId\":\"{{rentalRequestId}}\"\n}" } }
        },
        {
          "name": "Get My Payments - GET /payments",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Array',()=>d.data.length>0);","pm.test('Pagination',()=>d.meta!==undefined);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/payments?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["payments"], "query":[{"key":"page","value":"1"},{"key":"limit","value":"10"}] }, "header": [{"key":"Authorization","value":"Bearer {{tenantToken}}"}] }
        },
        {
          "name": "Get Payment by ID - GET /payments/:id",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Has id',()=>d.data.id!==undefined);","pm.test('Has amount',()=>d.data.amount>0);","pm.test('Has status',()=>d.data.status!==undefined);","pm.test('Has rentalRequest',()=>d.data.rentalRequest!==undefined);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["payments","{{paymentId}}"] }, "header": [{"key":"Authorization","value":"Bearer {{tenantToken}}"}] }
        },
        {
          "name": "Confirm Payment - POST /payments/confirm",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('PAID',()=>d.data.status==='PAID');","pm.test('Transaction ID',()=>d.data.transactionId!==null);","console.log('Transaction: '+d.data.transactionId);"] } }],
