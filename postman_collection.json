    {
      "name": "03 - Landlord Properties",
      "item": [
        {
          "name": "Create Property",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 201', () => pm.response.code === 201);",
                "pm.test('Property created', () => d.data.id !== undefined);",
                "pm.test('Has title', () => d.data.title !== undefined);",
                "pm.test('Has price', () => d.data.price > 0);",
                "if(d.data && d.data.id){ pm.collectionVariables.set('propertyId', d.data.id); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/properties", "host": ["{{baseUrl}}"], "path": ["properties"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Luxury Flat in Banani\",\n  \"description\": \"3 bedroom luxury apartment with pool and gym\",\n  \"price\": 65000,\n  \"location\": \"Banani, Dhaka\",\n  \"category\": \"apartment\"\n}" }
          }
        },
        {
          "name": "Get My Properties",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Has properties', () => d.data.length > 0);",
                "pm.test('Has pagination', () => d.meta !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/landlord/properties?page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["landlord", "properties"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "5" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{landlordToken}}" }]
          }
        },
        {
          "name": "Update Property",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Title updated', () => d.data.title === 'Updated Luxury Flat');",
                "pm.test('Price updated', () => d.data.price === 70000);"
              ]
            }
          }],
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
