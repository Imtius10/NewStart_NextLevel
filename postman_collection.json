{
  "info": {
    "name": "RentNest API - Full Test",
    "description": "Import → Run 01-Auth first → Then run others in order",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "adminToken", "value": "" },
    { "key": "landlordToken", "value": "" },
    { "key": "tenantToken", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "rentalRequestId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth (Run First)",
      "item": [
        {
          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Login success', () => d.success === true);",
                "if(d.data && d.data.accessToken){ pm.collectionVariables.set('adminToken', d.data.accessToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"imtius3@example.com\",\n  \"password\": \"12345678\"\n}" }
          }
        },
        {
          "name": "Login Landlord",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Login success', () => d.success === true);",
                "if(d.data && d.data.accessToken){ pm.collectionVariables.set('landlordToken', d.data.accessToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"imtius1@example.com\",\n  \"password\": \"12345678\"\n}" }
          }
        },
        {
          "name": "Login Tenant",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Login success', () => d.success === true);",
                "if(d.data && d.data.accessToken){ pm.collectionVariables.set('tenantToken', d.data.accessToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tanvir@tenant.com\",\n  \"password\": \"123456\"\n}" }
          }
        },
        {
          "name": "Get Profile",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Has user data', () => pm.response.json().data.email !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/my-profile", "host": ["{{baseUrl}}"], "path": ["auth", "my-profile"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "02 - Properties Public",
      "item": [
        {
          "name": "Get All Properties",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Has data', () => Array.isArray(d.data));",
                "pm.test('Has pagination', () => d.meta.total > 0);",
                "if(d.data && d.data.length > 0){ pm.collectionVariables.set('propertyId', d.data[0].id); }"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/properties?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["properties"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Get Categories",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Has categories', () => Array.isArray(pm.response.json().data));"
              ]
            }
          }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/properties/categories", "host": ["{{baseUrl}}"], "path": ["properties", "categories"] } }
        },
        {
          "name": "Filter by Location",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/properties?location=Gulshan&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query": [{ "key": "location", "value": "Gulshan" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "5" }] }
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/properties?category=apartment&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query": [{ "key": "category", "value": "apartment" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "5" }] }
          }
        },
        {
          "name": "Filter by Price Range",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/properties?minPrice=20000&maxPrice=50000&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query": [{ "key": "minPrice", "value": "20000" }, { "key": "maxPrice", "value": "50000" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "5" }] }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/properties?search=studio&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["properties"], "query": [{ "key": "search", "value": "studio" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "5" }] }
          }
        },
        {
          "name": "Get Property by ID",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Has property', () => pm.response.json().data.id !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] }
          }
        }
      ]
    },
    {
      "name": "03 - Landlord Properties",
      "item": [
        {
          "name": "Create Property",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status is 201', () => pm.response.code === 201);",
                "pm.test('Property created', () => d.data.id !== undefined);",
                "if(d.data && d.data.id){ pm.collectionVariables.set('propertyId', d.data.id); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/properties", "host": ["{{baseUrl}}"], "path": ["properties"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Test Apartment Dhanmondi\",\n  \"description\": \"2 bedroom apartment near lake\",\n  \"price\": 28000,\n  \"location\": \"Dhanmondi, Dhaka\",\n  \"category\": \"apartment\"\n}" }
          }
        },
        {
          "name": "Get My Properties",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Has properties', () => d.data.length > 0);",
                "pm.test('Has pagination', () => d.meta !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/landlord/properties?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["landlord", "properties"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{landlordToken}}" }]
          }
        },
        {
          "name": "Update Property",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Title updated', () => pm.response.json().data.title === 'Updated Test Apartment');"
              ]
            }
          }],
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Test Apartment\",\n  \"price\": 32000\n}" }
          }
        },
        {
          "name": "Delete Property",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.code === 200);",
                "pm.test('Deleted', () => pm.response.json().data === null);"
              ]
            }
          }],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{landlordToken}}" }]
          }
        }
      ]
    },
    {
      "name": "04 - Rental Requests",
      "item": [
        {
          "name": "Create Rental Request (Tenant)",
          "event": [{
            "listen": "test",
