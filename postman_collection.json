{
  "info": {
    "name": "RentNest API - Live Test",
    "description": "Base URL: https://rent-nest-api-seven.vercel.app/api\nRun 01-Auth first, then others in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://rent-nest-api-seven.vercel.app/api" },
    { "key": "adminToken", "value": "" },
    { "key": "landlordToken", "value": "" },
    { "key": "tenantToken", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "rentalRequestId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth (Run First)",
      "item": [
        {
          "name": "Register User",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 201', () => pm.response.code === 201);",
                "pm.test('User created', () => d.data.id !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"TENANT\"\n}" }
          }
        },
        {
          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Login success', () => d.success === true);",
                "pm.test('Has token', () => d.data.accessToken.length > 10);",
                "if(d.data && d.data.accessToken){ pm.collectionVariables.set('adminToken', d.data.accessToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@rentnest.com\",\n  \"password\": \"admin123\"\n}" }
          }
        },
        {
          "name": "Login Landlord",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Login success', () => d.success === true);",
                "if(d.data && d.data.accessToken){ pm.collectionVariables.set('landlordToken', d.data.accessToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"imtius1@example.com\",\n  \"password\": \"12345678\"\n}" }
          }
        },
        {
          "name": "Login Tenant",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Login success', () => d.success === true);",
                "if(d.data && d.data.accessToken){ pm.collectionVariables.set('tenantToken', d.data.accessToken); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"tanvir@tenant.com\",\n  \"password\": \"123456\"\n}" }
          }
        },
        {
          "name": "Get Profile",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json();",
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Has email', () => d.data.email !== undefined);",
                "pm.test('Has role', () => d.data.role !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/my-profile", "host": ["{{baseUrl}}"], "path": ["auth", "my-profile"] },
            "header": [{ "key": "Authorization", "value": "Bearer {{tenantToken}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Has new token', () => pm.response.json().data.accessToken !== undefined);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "Logout",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.code === 200);",
                "pm.test('Logged out', () => pm.response.json().message.includes('logout') || pm.response.json().message.includes('Logout'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
