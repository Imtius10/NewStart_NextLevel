{
  "info": {
    "name": "RentNest API - Live Test",
    "description": "Live URL: https://rent-nest-api-seven.vercel.app/api\nRun 01-Auth first, then others in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://rent-nest-api-seven.vercel.app/api" },
    { "key": "adminToken", "value": "" },
    { "key": "landlordToken", "value": "" },
    { "key": "tenantToken", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "rentalRequestId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "userId", "value": "" }
