          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json();","pm.test('200',()=>pm.response.code===200);","pm.test('Users',()=>d.data.users.total>0);","pm.test('Properties',()=>d.data.properties.total>0);","pm.test('Requests',()=>d.data.rentalRequests.total>0);","console.log('Users:'+d.data.users.total+' Props:'+d.data.properties.total+' Requests:'+d.data.rentalRequests.total);"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/statistics", "host": ["{{baseUrl}}"], "path": ["admin","statistics"] }, "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}] }
        }
      ]
