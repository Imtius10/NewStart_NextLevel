{
  "info": {
    "name": "RentNest API",
    "description": "Backend API for Rental Property Marketplace",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "tenantToken",
      "value": ""
    },
    {
      "key": "landlordToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "propertyId",
      "value": ""
    },
    {
      "key": "rentalRequestId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin (imtius3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken){",
                  "  pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
                  "  console.log('Admin token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"imtius3@example.com\",\n  \"password\": \"12345678\"\n}"
            }
          }
        },
        {
          "name": "Login Landlord (imtius1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken){",
                  "  pm.collectionVariables.set('landlordToken', jsonData.data.accessToken);",
                  "  console.log('Landlord token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"imtius1@example.com\",\n  \"password\": \"12345678\"\n}"
            }
          }
        },
        {
          "name": "Login Tenant (tanvir)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.accessToken){",
                  "  pm.collectionVariables.set('tenantToken', jsonData.data.accessToken);",
                  "  console.log('Tenant token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tanvir@tenant.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Get My Profile (Tenant)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/my-profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Properties (Public)",
      "item": [
        {
          "name": "Get All Properties",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search by Location",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties?location=Gulshan&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "location", "value": "Gulshan" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties?category=apartment&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "category", "value": "apartment" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter by Price Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties?minPrice=20000&maxPrice=50000&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "minPrice", "value": "20000" },
                { "key": "maxPrice", "value": "50000" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/categories"
          }
        },
        {
          "name": "Get Property by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/{{propertyId}}"
          }
        }
      ]
    },
    {
      "name": "Landlord - Properties",
      "item": [
        {
          "name": "Get My Properties",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.length > 0){",
                  "  pm.collectionVariables.set('propertyId', jsonData.data[0].id);",
                  "  console.log('First property ID saved: ' + jsonData.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/landlord/properties?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["landlord", "properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ]
          }
        },
        {
          "name": "Create Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.id){",
                  "  pm.collectionVariables.set('propertyId', jsonData.data.id);",
                  "  console.log('Property ID saved: ' + jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/properties",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Test Property\",\n  \"description\": \"A test property for demo\",\n  \"price\": 25000,\n  \"location\": \"Gulshan, Dhaka\",\n  \"category\": \"apartment\"\n}"
            }
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/properties/{{propertyId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Property Title\",\n  \"price\": 30000\n}"
            }
          }
        },
        {
          "name": "Delete Property",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/properties/{{propertyId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Landlord - Rental Requests",
      "item": [
        {
          "name": "Get My Rental Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.length > 0){",
                  "  pm.collectionVariables.set('rentalRequestId', jsonData.data[0].id);",
                  "  console.log('Rental Request ID saved: ' + jsonData.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/landlord/requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["landlord", "requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ]
          }
        },
        {
          "name": "Approve Rental Request",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/landlord/requests/{{rentalRequestId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            }
          }
        },
        {
          "name": "Reject Rental Request",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/landlord/requests/{{rentalRequestId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\"\n}"
            }
          }
        },
        {
          "name": "Get Property Requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/landlord/properties/{{propertyId}}/requests",
            "header": [
              { "key": "Authorization", "value": "Bearer {{landlordToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Tenant - Rental Requests",
      "item": [
        {
          "name": "Create Rental Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.id){",
                  "  pm.collectionVariables.set('rentalRequestId', jsonData.data.id);",
                  "  console.log('Rental Request ID saved: ' + jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/rentals",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"message\": \"I would like to rent this property\"\n}"
            }
          }
        },
        {
          "name": "Get My Rental Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.length > 0){",
                  "  var pending = jsonData.data.find(r => r.status === 'PENDING' || r.status === 'APPROVED');",
                  "  if(pending){",
                  "    pm.collectionVariables.set('rentalRequestId', pending.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rentals/my-requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["rentals", "my-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ]
          }
        },
        {
          "name": "Get Rental Request by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/rentals/{{rentalRequestId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Tenant - Payments",
      "item": [
        {
          "name": "Create Payment (Stripe Checkout)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/payments/create",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalRequestId\": \"{{rentalRequestId}}\"\n}"
            }
          }
        },
        {
          "name": "Get My Payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.length > 0){",
                  "  pm.collectionVariables.set('paymentId', jsonData.data[0].id);",
                  "  console.log('Payment ID saved: ' + jsonData.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/my-payments?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "my-payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ]
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/payments/{{paymentId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ]
          }
        },
        {
          "name": "TEST - Confirm Payment (simulate webhook)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/payments/test-confirm",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Tenant - Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reviews",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalRequestId\": \"{{rentalRequestId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great property, highly recommended!\"\n}"
            }
          }
        },
        {
          "name": "Get Property Reviews",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reviews/property/{{propertyId}}?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "property", "{{propertyId}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.length > 0){",
                  "  var tenant = jsonData.data.find(u => u.role === 'TENANT');",
                  "  if(tenant){",
                  "    pm.collectionVariables.set('userId', tenant.id);",
                  "    console.log('User ID saved: ' + tenant.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Ban User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/users/{{userId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"BLOCKED\"\n}"
            }
          }
        },
        {
          "name": "Unban User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/users/{{userId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Get All Properties (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/properties?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Delete Property (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/properties/{{propertyId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Get All Rental Requests (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/rental-requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "rental-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/statistics",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        }
      ]
    }
  ]
}
