model Property {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  location    String
  category    String
  landlordId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // landlord User @relation(
  //   "LandlordProperties",
  //   fields: [landlordId],
  //   references: [id],
  //   onDelete: Cascade
  // )

  landlord User @relation("LandlordProperties",fields: [landlordId],references: [id],onDelete: Cascade)

  rentalRequests RentalRequest[]
  reviews Review[]
}